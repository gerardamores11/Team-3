<?php
$SN = "localhost";
$DBuser = "root";
$DBpass = "";
$DBname = "sunsolart3";

$conn = new mysqli($SN, $DBuser, $DBpass, $DBname);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

$FN = $_POST["Fname"] ?? "";
$LN = $_POST["Lname"] ?? "";
$BD = $_POST["Bday"] ?? "";
$GD = $_POST["Gndr"] ?? "";
$EM = $_POST["EmAdd"] ?? "";
$PHN = $_POST["PhNo"] ?? "";
$AD = $_POST["Addrs"] ?? "";
$UN = $_POST["Uname"] ?? "";
$PW = $_POST["Pwd"] ?? "";
$RL = $_POST["Rl"] = "User";

$sql = "INSERT INTO acc (Firstname, Lastname, Birthdate, Gender, Email, Phone, Address, Username, password, Role) 
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";



$stmt = $conn->prepare($sql);
$stmt->bind_param("ssssssssss", $FN, $LN, $BD, $GD, $EM, $PHN, $AD, $UN, $PW, $RL);

if ($stmt->execute()) {
    echo "<p style='color:green;'>Registration successful!</p>";
} else {
    echo "<p style='color:red;'>Error: " . $stmt->error . "</p>";
}

$stmt->close();
$conn->close();
?>
