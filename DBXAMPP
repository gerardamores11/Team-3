<?php
$SN = "localhost";
$DBuser = "root";
$DBpass = "";
$DBname = "sunsolart3";

$conn = new mysqli($SN, $DBuser, $DBpass, $DBname);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

$FN = $_POST["Fname"] ?? "";
$EM = $_POST["EmAdd"] ?? "";
$UN = $_POST["Uname"] ?? "";
$PW = $_POST["Pwd"] ?? "";
$CPW = $_POST["CPwd"] ?? "";
$PHN = $_POST["PhNo"] ?? "";
$CNTY = $_POST["Cntry"] ?? "";
$T = isset($_POST["TnC"]) ? 1 : 0;

$sql = "INSERT INTO regform (full_name, email, username, password, phone, country) 
        VALUES (?, ?, ?, ?, ?, ?)";

$stmt = $conn->prepare($sql);
$stmt->bind_param("ssssss", $FN, $EM, $UN, $PW, $PHN, $CNTY);

if ($stmt->execute()) {
    echo "<p style='color:green;'>Registration successful!</p>";
} else {
    echo "<p style='color:red;'>Error: " . $stmt->error . "</p>";
}

$stmt->close();
$conn->close();
?>
