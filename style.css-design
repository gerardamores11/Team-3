   <style>
        body {
        font-family: Arial, sans-serif;
        background-color: #000000;
        margin: 0;
        padding: 0;
    }
    .container {
        width: 70%;
        margin:0 auto;
        background-color: rgb(19, 19, 19);
        padding: 50px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        margin-top: 50px;
        color: #fffefe;
        max-width: 500px;
       max-height: 800px;
       
    
    }
    .terms-container {
        display: flex;
        align-items: center;
        margin-top: 20px;
        margin-bottom: 20px;
        gap: 10px;
        justify-content: center;
        color: #fff6f6;
    }
    
    input[type="checkbox"] {
        margin-right: 10px;
        height: 30px;
       width: 20px;
       
      

    }  
    

    h2 {
        text-align: center;
    }
    form {
        display: flex;
        flex-direction: column;
    }
    label {
        margin-top: 10px;
    }
    input[type="text"], input[type="email"], input[type="password"], input[type="phone"] {
        padding: 10px;
        margin-top: 5px;
        border-radius: 5px;
        background-color: #2c2c2c;
        height: 10px;
        border: none;
   
    
    }
    input[type="county"], select {
        padding: 10px;
        margin-top: 5px;
        border-radius: 5px;
        background-color: #2c2b2b;
        color: #fffefe;
        border: none;
   
    }


    input[type="submit"] {
        margin-top: 20px;
        padding: 10px;
        background-color: #f35134;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        width: 70%;
        margin: 0 auto;
    }
    input[type="submit"]:hover {
        background-color: #e9dede;
    }
    
      

     
</style>
